{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CNMCP AI Resource Proposal v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "candidateId",
    "repository",
    "id",
    "name",
    "summary",
    "tags",
    "targetUsers",
    "capabilities",
    "usageNotes"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "candidateId": { "type": "string", "pattern": "^github:[a-z0-9_.-]+/[a-z0-9_.-]+$", "maxLength": 180 },
    "repository": { "$ref": "#/$defs/httpsUrl" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "minLength": 3, "maxLength": 80 },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "summary": { "type": "string", "minLength": 10, "maxLength": 300 },
    "tags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/registryId" }
    },
    "targetUsers": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 2, "maxLength": 100 }
    },
    "capabilities": {
      "type": "array",
      "maxItems": 12,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 2, "maxLength": 180 }
    },
    "usageNotes": {
      "type": "array",
      "maxItems": 12,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 2, "maxLength": 240 }
    }
  },
  "$defs": {
    "httpsUrl": { "type": "string", "pattern": "^https://[^\\s]+$", "maxLength": 2048 },
    "registryId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "minLength": 2, "maxLength": 64 }
  }
}
